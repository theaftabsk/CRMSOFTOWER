generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String   @id @default("ORG001")
  name       String
  logo_url   String?
  currency   String   @default("₹")
  timezone   String   @default("Asia/Kolkata")
  address    String?
  created_at DateTime @default(now())

  users        User[]
  roles        Role[]
  leads        Lead[]
  contacts     Contact[]
  accounts     Account[]
  deals        Deal[]
  tasks        Task[]
  callLogs     CallLog[]
  meetings     Meeting[]
  products     Product[]
  quotes       Quote[]
  orders       Order[]
  invoices     Invoice[]
  customFields CustomField[]
  auditLogs    AuditLog[]
  workflows    Workflow[]
  webhooks     Webhook[]
  apiKeys      ApiKey[]
  files        FileRecord[]
  tags         Tag[]
}

model User {
  id              String   @id @default(cuid())
  organization_id String
  name            String
  email           String   @unique
  phone           String?
  password_hash   String?  @default("$2b$10$EpRnTzVlqHNP0.fUbXUwSOyuiXe/QLSUG6x8ecr5eGdpfrWwHKgCu") // Default hash for 'password123'
  role            String   @default("Admin") // Admin, Manager, Sales Executive
  department      String?
  profile_photo   String?
  status          String   @default("Active")
  created_date    DateTime @default(now())
  last_login      String?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  userRoles    UserRole[]
}

model Role {
  id              String   @id @default(cuid())
  organization_id String
  name            String   // Owner, Admin, Manager, Sales Executive, Custom
  description     String?
  is_system       Boolean  @default(false)
  created_at      DateTime @default(now())

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g. leads:view, leads:create, deals:edit
  module      String   // leads, contacts, deals, finance, etc.
  description String?

  rolePermissions RolePermission[]
}

model RolePermission {
  id            String @id @default(cuid())
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
}

model UserRole {
  id      String @id @default(cuid())
  user_id String
  role_id String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
}

model Lead {
  id              String   @id @default(cuid())
  organization_id String
  name            String
  company         String
  email           String
  phone           String
  status          String   @default("New") // New, Contacted, Qualified, Converted, Unqualified
  source          String   @default("Website")
  assigned_to     String
  expected_value  Float    @default(0)
  created_date    DateTime @default(now())
  notes           String?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model Contact {
  id              String   @id @default(cuid())
  organization_id String
  account_id      String?
  name            String
  email           String
  phone           String
  designation     String?
  company         String
  city            String?
  status          String   @default("Active")
  created_date    DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [account_id], references: [id], onDelete: SetNull)
}

model Account {
  id              String   @id @default(cuid())
  organization_id String
  name            String
  industry        String
  website         String?
  annual_revenue  Float    @default(0)
  employee_count  Int      @default(0)
  billing_address String?
  created_date    DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]
  quotes       Quote[]
  orders       Order[]
  invoices     Invoice[]
}

model Deal {
  id              String   @id @default(cuid())
  organization_id String
  account_id      String?
  title           String
  account_name    String
  stage           String   @default("Qualification") // Qualification, Value Proposition, Proposal Sent, Negotiation, Closed Won, Closed Lost
  value           Float    @default(0)
  closing_date    String
  owner           String
  probability     Int      @default(50)
  created_date    DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [account_id], references: [id], onDelete: SetNull)
}

model Task {
  id              String   @id @default(cuid())
  organization_id String
  title           String
  assigned_to     String
  priority        String   @default("Medium") // High, Medium, Low, Urgent
  due_date        String
  status          String   @default("Pending") // Pending, Completed
  related_type    String?  // Lead, Contact, Account, Deal
  related_name    String?
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model CallLog {
  id              String   @id @default(cuid())
  organization_id String
  customer_name   String
  caller_user     String
  duration        String
  result          String
  notes           String?
  date_time       String
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model Meeting {
  id              String   @id @default(cuid())
  organization_id String
  title           String
  date_time       String
  participants    String[]
  status          String   @default("Scheduled") // Scheduled, Completed, Cancelled
  location        String?
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model Product {
  id               String   @id @default(cuid())
  organization_id  String   @default("ORG001")
  code             String
  name             String
  category         String
  unit_price       Float
  stock            Int
  gst_rate_percent Float    @default(18)
  created_at       DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model Quote {
  id              String   @id @default(cuid())
  organization_id String
  account_id      String?
  quote_number    String   @unique
  account_name    String
  subtotal        Float
  tax             Float
  total           Float
  status          String   @default("Draft") // Draft, Sent, Accepted, Rejected
  created_date    DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [account_id], references: [id], onDelete: SetNull)
  items        QuoteItem[]
}

model QuoteItem {
  id           String @id @default(cuid())
  quote_id     String
  product_name String
  qty          Int
  unit_price   Float
  total        Float

  quote Quote @relation(fields: [quote_id], references: [id], onDelete: Cascade)
}

model Order {
  id              String   @id @default(cuid())
  organization_id String
  account_id      String?
  order_number    String   @unique
  account_name    String
  total_amount    Float
  status          String   @default("Pending") // Pending, Confirmed, Shipped, Delivered, Cancelled
  created_date    DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [account_id], references: [id], onDelete: SetNull)
  items        OrderItem[]
}

model OrderItem {
  id           String @id @default(cuid())
  order_id     String
  product_name String
  qty          Int
  unit_price   Float
  total        Float

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

model Invoice {
  id              String   @id @default(cuid())
  organization_id String
  account_id      String?
  invoice_number  String   @unique
  account_name    String
  total_amount    Float
  paid_amount     Float    @default(0)
  due_amount      Float
  status          String   @default("Unpaid") // Unpaid, Partial, Paid
  issue_date      String
  due_date        String

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [account_id], references: [id], onDelete: SetNull)
  payments     Payment[]
}

model Payment {
  id             String   @id @default(cuid())
  invoice_id     String
  payment_number String   @unique
  amount         Float
  payment_date   String
  method         String   @default("UPI") // UPI, Bank, Cash, Card, Online Gateway
  notes          String?
  created_at     DateTime @default(now())

  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
}

model CustomField {
  id              String   @id @default(cuid())
  organization_id String
  entity_type     String   // Lead, Contact, Account, Deal
  field_name      String
  field_type      String   // Text, Number, Currency, Dropdown, Date
  options         String[]
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model AuditLog {
  id              String   @id @default(cuid())
  organization_id String
  user_name       String
  action          String
  entity_type     String
  entity_id       String
  previous_value  String?
  new_value       String?
  ip_address      String?
  timestamp       String

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model Workflow {
  id              String   @id @default(cuid())
  organization_id String
  name            String
  description     String?
  trigger_event   String   // lead.created, deal.won, invoice.overdue
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  triggers     WorkflowTrigger[]
  actions      WorkflowAction[]
  executions   WorkflowExecution[]
}

model WorkflowTrigger {
  id          String   @id @default(cuid())
  workflow_id String
  condition   String   // e.g. status == 'Qualified'
  created_at  DateTime @default(now())

  workflow Workflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
}

model WorkflowAction {
  id          String   @id @default(cuid())
  workflow_id String
  action_type String   // create_task, send_email, notify_slack, webhook
  parameters  Json
  created_at  DateTime @default(now())

  workflow Workflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
}

model WorkflowExecution {
  id          String   @id @default(cuid())
  workflow_id String
  status      String   // Success, Failed
  log_message String?
  executed_at DateTime @default(now())

  workflow Workflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
}

model Webhook {
  id              String   @id @default(cuid())
  organization_id String
  target_url      String
  events          String[] // lead.created, deal.won, invoice.paid
  secret_token    String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  logs         WebhookLog[]
}

model WebhookLog {
  id          String   @id @default(cuid())
  webhook_id  String
  event       String
  status_code Int
  payload     Json
  response    String?
  executed_at DateTime @default(now())

  webhook Webhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade)
}

model ApiKey {
  id              String    @id @default(cuid())
  organization_id String
  key_name        String
  api_key_hash    String    @unique
  permissions     String[]
  expires_at      DateTime?
  created_at      DateTime  @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model FileRecord {
  id              String   @id @default(cuid())
  organization_id String
  entity_type     String   // Lead, Deal, Account, Invoice
  entity_id       String
  file_name       String
  file_url        String
  mime_type       String
  file_size_bytes Int
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model Tag {
  id              String   @id @default(cuid())
  organization_id String
  name            String
  color           String   @default("#2563eb")
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, name])
}

model SaaSPlan {
  id                   String   @id @default(cuid())
  tier                 String   @unique // FREE, STARTER, PROFESSIONAL, BUSINESS, ENTERPRISE
  price_per_user_month Float
  user_limit           Int
  features             String[]
  is_active            Boolean  @default(true)
}
